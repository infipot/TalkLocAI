# ============================================================
# VoiceAI – Environment Variables Template
# Copy to .env and fill in your actual values.
# Never commit your real .env file!
# ============================================================

# OpenRouter API Key (required when provider is "auto" or "openrouter")
# The code checks OPENROUTER_API_KEY env var first, then falls back
# to config.json.  Obtain at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ElevenLabs API Key (optional – only used when tts_engine is "elevenlabs")
# The code checks ELEVENLABS_API_KEY env var first, then falls back
# to config.json.  Obtain at: https://elevenlabs.io/app/api-key
ELEVENLABS_API_KEY=

# ElevenLabs Voice ID (optional – only used when tts_engine is "elevenlabs")
ELEVENLABS_VOICE_ID=
